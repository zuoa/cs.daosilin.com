# sqlite 本地开发可留空 DATABASE_URL / REDIS_URL
# DATABASE_URL=postgresql://cs:cs@127.0.0.1:5432/cs
# REDIS_URL=redis://127.0.0.1:6379/0
# HISTORY_SQL_PATH=/app/bootstrap/cs_history.sql
#
# 前端开发：终端1 python app.py ；终端2 cd web && npm run dev
# 生产：cd web && npm run build ，由 Flask 托管 web/dist

SECRET_KEY=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1005
SITE_NAME=熊掌CS Major

# DeepSeek 选手赛季点评（API Key 只从部署环境读取）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash
LLM_REQUEST_TIMEOUT=45
PLAYER_SUMMARY_PROMPT_VERSION=v1

# 对外选手数据 API；可留空后在「管理后台 → API 与安全」中生成
# 如果设置，环境变量优先级高于后台保存的 token
EXTERNAL_API_TOKEN=

# 完美比赛采集及 Demo 下载凭证；Demo 后台凭证未保存时回退到这里
WMPVP_ACCESS_TOKEN=
WMPVP_STEAM_ID=

# 完美段位默认每天 02:15、08:15、14:15、20:15 刷新；小时用逗号分隔
PERFECT_RANK_REFRESH_HOURS=2,8,14,20
# 批量查询玩家之间的间隔秒数，避免请求过快
PERFECT_RANK_REQUEST_INTERVAL=0.2

# Demo 第二阶段分析由管理后台开关启停（需要 Redis 与独立 demo-worker）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEMO_CREDENTIAL_ENCRYPTION_KEY=
DEMO_STORAGE_PATH=/data/demos
DEMO_MAX_BYTES=1073741824
DEMO_ANALYZER_TIMEOUT=840
DEMO_METRIC_VERSION=v1
DEMO_BACKFILL_DAYS=30
