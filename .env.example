# sqlite 本地开发可留空 DATABASE_URL / REDIS_URL
# DATABASE_URL=postgresql://cs:cs@127.0.0.1:5432/cs
# REDIS_URL=redis://127.0.0.1:6379/0
# HISTORY_SQL_PATH=/app/bootstrap/cs_history.sql
#
# 前端开发：终端1 python app.py ；终端2 cd web && npm run dev
# 生产：cd web && npm run build ，由 Flask 托管 web/dist

SECRET_KEY=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1005
SITE_NAME=熊掌CS Major

# 对外选手数据 API；可留空后在「管理后台 → API 与安全」中生成
# 如果设置，环境变量优先级高于后台保存的 token
EXTERNAL_API_TOKEN=
